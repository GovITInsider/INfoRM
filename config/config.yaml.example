general:
  log_level: INFO
  poll_interval_seconds: 30

discovery:
  enabled: true

logging:
  log_file: logs/inform.log

monitoring:
  countbeforealarm: 2
  poll_interval_seconds: 30

web:
  auto_refresh_seconds: 30
  noc_auto_refresh_seconds: 30
  local_timezone: "America/Los_Angeles"

security:
  secret_key: "CHANGE_ME_IN_.env"     # ← placeholder only
  token_expires_minutes: 480   # admin session length in minutes (renewed while you work)
